<h1>User Show Page</h1>
<h3>Created Events</h3>
<% @user.created_events.each do |e| %>
  <%= render partial: "shared/event_card", locals: { event: e } %>
<% end %>

<h3>Attending Events</h3>

<h3>Upcoming</h3>
<% @user.attending_events.each do |e| %>
  <% if e.date >= Time.now %>
    <%= render partial: "shared/event_card", locals: { event: e } %>
  <% end %>
<% end %>

<h3>Past</h3>
<% @user.attending_events.each do |e| %>
  <% if e.date  < Time.now %>
    <%= render partial: "shared/event_card", locals: { event: e } %>
  <% end %>
<% end %>

<h3>Invites</h3>
<% @invited_attendances.each do |attendance| %>
  <% event = attendance.event %>
  <%= tag.p "New Invite" %>
  <%= link_to event.title, event_path(event.id) %>
  <%= button_to "Accept", event_attendance_path(event.id, attendance.id), method: :patch, params: { attendance: { status: "going" } } %>
  <%= button_to "Reject" %>
<% end %>