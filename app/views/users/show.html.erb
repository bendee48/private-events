
<h3>Created Events</h3>
<%= tag.div(class: 'event-card-container') do %>
  <% @user.created_events.each do |e| %>
    <%= render partial: "shared/event_card", locals: { event: e, show_attendance: false } %>
  <% end %>
<% end %>

<h3>Attending Events</h3>
<br/>
<h4>Upcoming</h4>
<%= tag.div(class: 'event-card-container') do %>
  <% @user.attending_events.each do |e| %>
    <% if e.date >= Time.now %>
      <%= render partial: "shared/event_card", locals: { event: e, show_attendance: true } %>
    <% end %>
  <% end %>
<% end %>

<h4>Past</h4>
<%= tag.div(class: 'event-card-container') do %>
  <% @user.attending_events.each do |e| %>
    <% if e.date  < Time.now %>
      <%= render partial: "shared/event_card", locals: { event: e, show_attendance: false } %>
    <% end %>
  <% end %>
<% end %>

<h3 id="invites">Invites</h3>
<% @invited_attendances.each do |attendance| %>
  <% event = attendance.event %>
  <%= tag.p "New Invite from #{event.creator.username}" %>
  <%= link_to event.title, event_path(event.id) %>
  <%= button_to "Accept", event_attendance_path(event, attendance), method: :patch, params: { attendance: { status: "going" } } %>
  <%= button_to "Reject", event_attendance_path(event, attendance), method: :patch, params: { attendance: { status: "not going"} } %>
<% end %>