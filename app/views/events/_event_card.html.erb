<%= tag.div class: "card" do %>
  <%= tag.div class: "card-header" do %>
    <%= link_to event_path(event.id) do %>
      <%= tag.h3 event.title %>
    <% end %>
  <% end %>
  <%= tag.div class: "card-body" do %>
    <%= tag.p event.date %>
    <%= tag.p "Where: " + event.location %>
    <%= tag.p "Creator: " + event.creator.username %>
  <% end %>
  <%= tag.div class: "card-footer" do %>
    <% if current_user.attending?(event) %>
      <%= button_to "You're going!", root_path, disabled: true, class: "btn" %>
    <% else %>
      <%= button_to "Attend", event_attendances_path(event), class: "btn" %>
    <% end %>
  <% end %>
<% end %>