<h1>New Event</h1>

<%= render "devise/shared/error_messages", resource: @event %>

<%= form_with model: @event do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>
  <div>
    <%= form.label :date %>
    <%= form.date_field :date %>
  </div>
  <div>
    <%= form.label :location %>
    <%= form.text_field :location %>
  </div>
  <div>
    <%= form.check_box :visibility, {}, "private_event", "public_event" %>
    <%= form.label :visibility, "Private event" %>
  </div>
  <%= form.submit %>
<% end %>