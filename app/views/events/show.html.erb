<h1>Event Show Page</h1>

<%= render partial: "event_card", locals: { event: @event } %>

<%= tag.h3 "Users" %>
<% @users.each do |user| %>
  <%= tag.ul do %>
    <%= tag.li user.username %>
    <% if user.invited?(@event) %>
      <%= tag.li 'Invited' %>
    <% else %>
      <%= button_to "Invite", event_attendances_path(@event) %>
    <% end %>
  <% end %>
<% end %>

<%= tag.h3 "Attendees" %>
<% @event.attendees.each do |a| %>
  <%= tag.p a.username %>
<% end %>
