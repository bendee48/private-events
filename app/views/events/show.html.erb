<h1>Event Show Page</h1>

<%= render partial: "event_card", locals: { event: @event } %>


<%= tag.h3 "Users" %>
<% @users.each do |user| %>
  <%= tag.ul do %>
    <%= tag.li user.username %>
    <% if user.invited?(@event) %>
      <%= tag.li 'Invited' %>
    <% elsif user.attending?(@event) %>
      <%= tag.li 'Attending' %>
    <% end %>
    <% if @event.creator.username == current_user.username && !user.attendance_created?(@event) %>
      <%= button_to "Invite", event_attendances_path(@event), params: { user_id: user.id } %>
    <% end %>
  <% end %>
<% end %>

<%= tag.h3 "Going" %>
<% @guests.each do |a| %>
  <%= tag.p a.username %>
<% end %>
