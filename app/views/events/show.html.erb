<h1>Event Show Page</h1>

<%= render partial: "shared/event_card", locals: { event: @event } %>

<% if current_user.invited?(@event) %>
  <%= link_to user_path(current_user) + "#invites" do %>
    <%= tag.li 'You\'ve been invited.' %>
  <% end %>
<% elsif current_user.attending?(@event) %>
  <%= tag.li "You're going to this event." %>
<% elsif current_user.declined?(@event) %>
  <%= tag.li "You can't make this event." %>
<% end %>

<% if @event.created_by?(current_user) %>
  <%= tag.h3 "Invite" %>
  <% @users.each do |user| %>
    <%= tag.ul do %>
      <%= tag.li user.username %>
      <% if user.invited?(@event) %>
        <%= tag.li 'Invited' %>
      <% elsif user.attending?(@event) %>
        <%= tag.li 'Attending' %>
      <% elsif user.declined?(@event) %>
        <%= tag.li 'Declined' %>
      <% end %>
      <% if !user.attendance_created?(@event) %>
        <%= button_to "Invite", event_attendances_path(@event), params: { user_id: user.id } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= tag.h3 "Attendees" %>
<% @attendees.each do |a| %>
  <%= tag.p a.username %>
<% end %>
