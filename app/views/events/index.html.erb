<h1>Events#index</h1>
<p>Find me in app/views/events/index.html.erb</p>
<br/ >
<br/ >
<br/ >
<%= button_to "Create Event", new_event_path, method: :get, class: "btn" %>
<br/>
<br/>
<h2>Upcoming Events</h2>
<% @upcoming_events.each do |event| %>
  <%= render partial: "event_card", locals: { event: event } %>
<% end %>

<h2>Past Events</h2>
<% @past_events.each do |event| %>
  <%= render partial: "event_card", locals: { event: event } %>
<% end %>
