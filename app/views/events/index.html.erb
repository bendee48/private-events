<h1>Events</h1>
<br/>
<% if user_signed_in? %>
  <%= button_to "Create Event", new_event_path, method: :get, class: "btn" %>
<% end %>
<br/>
<h2 class="events-header">Upcoming Events</h2>
<%= tag.div(class: "card-container") do %>
  <% @upcoming_events.each do |event| %>
    <%= render partial: "shared/event_card", locals: { event: event, show_attendance: false } %>
  <% end %>
<% end %>


<h2 class="events-header">Past Events</h2>
<% @past_events.each do |event| %>
  <%= render partial: "shared/event_card", locals: { event: event, show_attendance: false } %>
<% end %>
